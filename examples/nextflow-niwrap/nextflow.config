// Nextflow configuration for the nextflow-niwrap example.
//
// The Python helper scripts in src/nextflow_niwrap/ use NiWrap, which must be
// available in the Python environment that Nextflow sees. The easiest way is to
// run the workflow from the repository root with the workspace venv active, or
// to set params.python_cmd to invoke Python through uv, e.g.:
//
//     params.python_cmd = "uv run python3"

params {
    data_dir = "${projectDir}/../.data"
    output_dir = "${launchDir}/output"
    subject = '01'
    template = 'MNI152NLin2009cAsym'
    bet_fractional_intensity = null

    // Command used to run Python helper scripts. Change this if you prefer to
    // activate a specific conda/venv environment instead of using uv.
    python_cmd = "uv run python3"
}

process {
    executor = 'local'
}

env {
    PYTHONUNBUFFERED = '1'
}
